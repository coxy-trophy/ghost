<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      "Obsidian Futurism", from the Stitch design system, with one deliberate change: the base is
      true #000000 rather than the system's #101415, because this is an AMOLED panel and black
      pixels are off pixels — on a daemon that may sit face-up on a desk all night, that is both
      the look and the power budget.

      Cards sit just above the void so they read as objects in it rather than as a lighter page.
    -->

    <!-- Base -->
    <color name="obsidian">#FF000000</color>
    <color name="surface">#FF0B0F10</color>
    <color name="surface_container">#FF14181A</color>
    <color name="surface_high">#FF1D2022</color>

    <!-- Glass: 3% fill, 10% border — straight from the design system -->
    <color name="glass_fill">#08FFFFFF</color>
    <color name="glass_fill_hover">#14FFFFFF</color>
    <color name="glass_border">#1AFFFFFF</color>
    <color name="divider">#0DFFFFFF</color>

    <!-- Primary: electric cyan -->
    <color name="cyan">#FF00F0FF</color>
    <color name="cyan_dim">#FF00DBE9</color>
    <color name="cyan_deep">#FF006970</color>
    <color name="cyan_glow">#2600F0FF</color>
    <color name="cyan_wash">#1400F0FF</color>

    <!-- Secondary: vibrant violet -->
    <color name="violet">#FFD0BCFF</color>
    <color name="violet_deep">#FF571BC1</color>

    <!-- Type -->
    <color name="on_surface">#FFE0E3E5</color>
    <color name="on_surface_variant">#FFB9CACB</color>
    <color name="on_surface_muted">#FF849495</color>
    <color name="on_accent">#FF00363A</color>

    <!-- State -->
    <color name="state_live">#FF00F0FF</color>
    <color name="state_idle">#FF849495</color>
    <color name="state_error">#FFFFB4AB</color>

    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
</resources>
