<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      "Paper". The light half of the palette; the dark half lives in values-night/colors.xml and
      carries the same names, so every layout and drawable in the app is written once and follows
      the phone.

      The ground is a warm off-white rather than #FFFFFF. Pure white against dark text is a harsher
      contrast than paper has ever had, and the warmth is what stops a text-heavy screen reading as
      a spreadsheet. Chrome is a tint of the ink, never a second background colour — a control is
      the page, slightly pressed, so the surface stays continuous from the status bar down.

      The accent ramp still means something rather than decorating. GHOST reads it as heat: cool is
      the local 1.5B answering, hot is the cloud brain. Two ends and no gradient in between, because
      there are two brains and a spectrum would imply a third state.

      The orb is deliberately absent from this file. Its ramp is hardcoded in OrbView.kt and is the
      one thing that does not follow the palette — it lives on Live's dark field in both modes, and
      it is the only saturated object in the app.

      Names are historical. `abyss` was true black when this was AMOLED-only and is now the page in
      both modes; renaming it touches every layout, which is a separate change from this one.
    -->

    <!-- Base -->
    <color name="abyss">#FFFAF9F5</color>
    <color name="surface">#FFF5F3EE</color>
    <color name="surface_container">#FFF0EDE5</color>
    <color name="surface_high">#FFE8E4DA</color>

    <!-- Chrome, as a tint of the ink rather than a lighter panel -->
    <color name="glass_fill">#08000000</color>
    <color name="glass_fill_hover">#14000000</color>
    <color name="glass_border">#1A000000</color>
    <color name="glass_border_bright">#29000000</color>
    <color name="divider">#12000000</color>

    <!-- The heat ramp: cool is the local brain, hot is the cloud -->
    <color name="cool">#FF5E6E8C</color>
    <color name="accent">#FFB85C38</color>
    <color name="accent_dim">#FFA05030</color>
    <color name="accent_deep">#FF6B3620</color>
    <color name="accent_soft">#FF8A6A56</color>
    <color name="accent_hot">#FFC1522E</color>
    <color name="ember">#FFB8452C</color>
    <color name="amber">#FFC08040</color>

    <!-- Accent washes, for glows and active fills -->
    <color name="accent_glow">#33B85C38</color>
    <color name="accent_wash">#14B85C38</color>
    <color name="ember_wash">#1FB8452C</color>

    <!-- Type -->
    <color name="on_surface">#FF2B2B28</color>
    <color name="on_surface_variant">#FF66635C</color>
    <color name="on_surface_muted">#FF97928A</color>
    <color name="on_accent">#FFFFFFFF</color>

    <!-- State -->
    <color name="state_live">#FFB85C38</color>
    <color name="state_idle">#FF97928A</color>
    <color name="state_error">#FFB3402F</color>

    <!--
      Live's field, which does not follow the phone.

      The orb is a thousand luminous points and it only reads against dark. A Live screen that went
      cream by day would be the one place the redesign made something worse, so this pair is the
      same value in both files.
    -->
    <color name="live_field">#FF0B0B0C</color>
    <color name="on_live_field">#FFF2F0F5</color>
    <color name="on_live_field_muted">#FF8A8792</color>
    <color name="live_accent">#FFE8C4B0</color>

    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
</resources>
