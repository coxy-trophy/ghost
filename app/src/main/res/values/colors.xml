<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      GHOST's palette. Dark by design rather than by preference: this thing lives face-up in a dark
      room beside someone, so a bright surface would be the wrong object to be.

      The glass tokens are deliberately low-alpha. Depth comes from the animated aurora showing
      through the panels, not from opaque greys stacked on each other.
    -->

    <!-- Base surfaces -->
    <color name="ghost_void">#FF05070A</color>
    <color name="ghost_deep">#FF080C12</color>

    <!-- Glass: translucent fills + hairline strokes, layered over the aurora -->
    <color name="glass_fill">#14FFFFFF</color>
    <color name="glass_fill_strong">#1FFFFFFF</color>
    <color name="glass_stroke">#24FFFFFF</color>
    <color name="glass_stroke_soft">#14FFFFFF</color>

    <!-- Accents. Cyan is GHOST's own colour; violet is the second light in the aurora. -->
    <color name="accent_cyan">#FF5EEAD4</color>
    <color name="accent_blue">#FF38BDF8</color>
    <color name="accent_violet">#FFA78BFA</color>
    <color name="accent_cyan_dim">#3D5EEAD4</color>
    <color name="accent_cyan_ghost">#1F5EEAD4</color>

    <!-- Aurora blob hues (alpha is applied in the drawing code) -->
    <color name="aurora_one">#FF0EA5E9</color>
    <color name="aurora_two">#FF8B5CF6</color>
    <color name="aurora_three">#FF14B8A6</color>

    <!-- Type -->
    <color name="text_primary">#FFEAF2F8</color>
    <color name="text_secondary">#FF93A7BA</color>
    <color name="text_tertiary">#FF5C6F80</color>
    <color name="text_on_accent">#FF04141A</color>

    <!-- State -->
    <color name="state_live">#FF34D399</color>
    <color name="state_idle">#FF64748B</color>
    <color name="state_warn">#FFFBBF24</color>

    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
</resources>
