<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Base.Theme.AiChatSample" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorSecondary">@color/accent_hot</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="android:colorBackground">@color/abyss</item>
        <item name="android:windowBackground">@color/abyss</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!--
          DrawerLayout draws its own status-bar scrim from android:colorPrimaryDark when
          fitsSystemWindows is set, which is not a colour this theme ever chose — it came out as a
          solid band of accent across the top of the app. The page runs under the status bar
          instead.
        -->
        <item name="android:colorPrimaryDark">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>
        <item name="android:textColorPrimary">@color/on_surface</item>
        <item name="android:textColorSecondary">@color/on_surface_variant</item>
        <item name="android:textColorHint">@color/on_surface_muted</item>
    </style>

    <style name="Theme.AiChatSample" parent="Base.Theme.AiChatSample" />

    <!--
      Two voices, kept strictly apart.

      Sans-serif is GHOST speaking — the greeting, her replies, anything addressed to Coxy. It is
      set large, heavy and tight, because the greeting is the only thing on an empty screen and it
      has to carry it.

      Monospace is the instrument panel — sensor values, brains, states. Kept lowercase rather than
      the usual small-caps treatment: this is machine output quoted verbatim, and `motion: still`
      is what the [CONTEXT] block literally says. Fixed-width also stops telemetry from reflowing
      every time a number changes width, which the old proportional labels did constantly.

      No font files are bundled. Space Grotesk / Inter would each add megabytes to an APK that is
      already ~100 MB, and the platform families carry the distinction that actually matters here.
    -->

    <!--
      GHOST's voice, at greeting scale.

      Serif, and set at a normal weight rather than black. The old treatment was a heavy compressed
      sans shouting one line across the middle of the screen, which suited a black field with an orb
      over it and suits a page of text very badly. A serif at reading weight says the same words as
      something written rather than something displayed, and Noto Serif ships with the platform, so
      the character costs nothing in an APK already near a hundred megabytes.
    -->
    <style name="TextAppearance.Ghost.Display" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">serif</item>
        <item name="fontFamily">serif</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">31sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:lineSpacingMultiplier">1.12</item>
    </style>

    <!--
      Her replies in the transcript.

      A step larger than [TextAppearance.Ghost.Body] and looser in the line, because this text has no
      bubble holding it and nothing but leading to separate it from the next turn. Sans rather than
      the greeting's serif: the greeting is one line and can be an object, a reply can be six
      paragraphs and has to be comfortable.
    -->
    <style name="TextAppearance.Ghost.Reply" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingExtra">7dp</item>
    </style>

    <!-- The quieter line above the greeting. -->
    <style name="TextAppearance.Ghost.DisplaySub" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/on_surface_muted</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- The identity pill's name. -->
    <style name="TextAppearance.Ghost.Wordmark" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <!-- The identity pill's subtitle: what GHOST is doing, not what she is. -->
    <style name="TextAppearance.Ghost.PillCaption" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/on_surface_muted</item>
        <item name="android:textSize">10sp</item>
    </style>

    <!-- Instrument panel: every sensor value in the app. -->
    <style name="TextAppearance.Ghost.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TextAppearance.Ghost.Mono" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.Ghost.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">5dp</item>
    </style>

    <style name="TextAppearance.Ghost.SectionTitle" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!--
      The drawer's rows. Sans, not mono: these are places to go, not readings.

      Grown from a 10sp tab caption to a 15sp list row. Under a five-icon bottom bar the label was a
      hint at what the icon meant; in a drawer the label is the thing being read and the icon is the
      hint.
    -->
    <style name="TextAppearance.Ghost.NavLabel" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/on_surface_muted</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Secondary action: a glass pill with a hairline. -->
    <!--
      A drawer row. Three styles rather than three copies of nine attributes on five rows each.

      The row keeps no background of its own: showTab() sets bg_nav_active on the current one and
      clears it on the rest, which is the same call it made when these were tabs.
    -->
    <style name="Widget.Ghost.DrawerRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">13dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.Ghost.DrawerRowIcon" parent="">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:contentDescription">@null</item>
    </style>

    <style name="Widget.Ghost.DrawerRowLabel" parent="TextAppearance.Ghost.NavLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">16dp</item>
    </style>

    <style name="Widget.Ghost.Outline" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/bg_button_ghost</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Primary action: the magenta-to-ember pill, the hot end of the ramp. -->
    <style name="Widget.Ghost.Primary" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Theme.Ghost.Dialog" parent="Theme.Material3.DayNight.Dialog.Alert">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorSurface">@color/surface_container</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:textColorPrimary">@color/on_surface</item>
        <item name="android:textColorSecondary">@color/on_surface_variant</item>
    </style>
</resources>
