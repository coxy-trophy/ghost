<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Locked to dark rather than DayNight. GHOST has one look, and it is the one that belongs on a
      phone lying face-up in a dark room.
    -->
    <style name="Base.Theme.AiChatSample" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent_cyan</item>
        <item name="colorOnPrimary">@color/text_on_accent</item>
        <item name="colorSecondary">@color/accent_violet</item>
        <item name="colorSurface">@color/ghost_deep</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="android:colorBackground">@color/ghost_void</item>

        <!-- The aurora is the background; the window must not paint over it. -->
        <item name="android:windowBackground">@color/ghost_void</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
    </style>

    <style name="Theme.AiChatSample" parent="Base.Theme.AiChatSample" />

    <!-- Compact glass control. The eight chunky outlined buttons became these. -->
    <style name="Widget.Ghost.GlassButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/bg_glass_button</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">42dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="TextAppearance.Ghost.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">0.22</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="TextAppearance.Ghost.Status" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.Ghost.Caption" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.03</item>
    </style>

    <!-- Dialogs inherit GHOST's palette instead of the stock grey Material sheet. -->
    <style name="Theme.Ghost.Dialog" parent="Theme.Material3.Dark.Dialog.Alert">
        <item name="colorPrimary">@color/accent_cyan</item>
        <item name="colorSurface">@color/ghost_deep</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>
</resources>
