<?xml version="1.0" encoding="utf-8"?>
<!--
  The drawer's current row. A soft rounded rectangle rather than the old pill: these are full-width
  list rows now, and a 100dp radius on a row that wide reads as a lozenge rather than a selection.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/accent_wash" />
    <corners android:radius="12dp" />
</shape>
