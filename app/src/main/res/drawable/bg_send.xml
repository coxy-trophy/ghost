<?xml version="1.0" encoding="utf-8"?>
<!-- Send shares the mic's gradient: both are "hand this to GHOST", one typed and one spoken. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#40FFFFFF">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="oval">
                    <solid android:color="#12FFFFFF" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <gradient android:type="linear" android:angle="270"
                        android:startColor="@color/accent"
                        android:centerColor="@color/accent_hot"
                        android:endColor="@color/ember" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
