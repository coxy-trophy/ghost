<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded square, not a circle: the design keeps the send action reading as hardware. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#3300363A">
    <item><selector>
        <item android:state_enabled="false"><shape android:shape="rectangle">
            <solid android:color="#0FFFFFFF" />
            <corners android:radius="12dp" />
        </shape></item>
        <item><shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="315"
                android:startColor="@color/cyan" android:endColor="@color/violet_deep" />
            <corners android:radius="12dp" />
        </shape></item>
    </selector></item>
</ripple>
