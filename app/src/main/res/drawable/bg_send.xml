<?xml version="1.0" encoding="utf-8"?>
<!--
  Send. One flat accent circle.

  The gradient this replaces was the loudest object in the app and it was spent on the most
  predictable control on the screen. Flat, it still reads as the only saturated thing in the
  composer, which is all the emphasis a send button has ever needed.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/glass_fill_hover">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="oval">
                    <solid android:color="@color/surface_high" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <solid android:color="@color/accent" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
