<?xml version="1.0" encoding="utf-8"?>
<!-- Touch feedback for a row inside a group. Square: the group carries the rounding. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/glass_fill_hover">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
        </shape>
    </item>
</ripple>
