<?xml version="1.0" encoding="utf-8"?>
<!-- Dialogs are opaque rather than glass on purpose: they sit above the aurora and need to be
     readable, and a translucent sheet over a moving background is hard to read. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="20dp" android:insetRight="20dp">
    <shape android:shape="rectangle">
        <solid android:color="#F00B1119" />
        <stroke android:width="1dp" android:color="@color/glass_stroke" />
        <corners android:radius="28dp" />
    </shape>
</inset>
