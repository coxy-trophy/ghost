<?xml version="1.0" encoding="utf-8"?>
<!--
  Hold-to-speak, in Live. Largest target on the screen and the only saturated one, because with
  nothing listening ambiently this is the whole way in. The pressed state fills to white-hot rather
  than rippling — the user is holding it against their face and needs to feel it engage, not see it.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="60%p"
                android:startColor="@color/white" android:endColor="@color/accent_hot" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient android:type="linear" android:angle="270"
                android:startColor="@color/accent"
                android:centerColor="@color/accent_hot"
                android:endColor="@color/ember" />
        </shape>
    </item>
</selector>
