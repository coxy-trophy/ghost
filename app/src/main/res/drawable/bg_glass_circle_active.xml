<?xml version="1.0" encoding="utf-8"?>
<!--
  The same control, lit, when the cloud brain is the one answering.

  A soft wash and no stroke. This is the one state worth marking with a shape rather than a tint —
  a reply that left the phone is the most consequential thing about it — and a filled disc says so
  without a border competing with the icon inside it.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/accent_glow">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/accent_wash" />
        </shape>
    </item>
</ripple>
