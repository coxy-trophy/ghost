<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#4004141A">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="oval">
                    <solid android:color="#14FFFFFF" />
                    <stroke android:width="1dp" android:color="@color/glass_stroke_soft" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <gradient
                        android:type="linear" android:angle="315"
                        android:startColor="@color/accent_cyan"
                        android:endColor="@color/accent_blue" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
