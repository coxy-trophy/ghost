<?xml version="1.0" encoding="utf-8"?>
<!-- The jump-to-latest button: a raised disc, quiet enough to ignore while you are reading back. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/glass_fill_hover">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/surface_high" />
            <stroke android:width="1dp" android:color="@color/glass_border" />
        </shape>
    </item>
</ripple>
