<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#3300363A">
    <item><selector>
        <item android:state_enabled="false"><shape android:shape="rectangle">
            <solid android:color="#14FFFFFF" />
            <corners android:radius="10dp" />
        </shape></item>
        <item><shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="0"
                android:startColor="@color/cyan" android:endColor="@color/violet" />
            <corners android:radius="10dp" />
        </shape></item>
    </selector></item>
</ripple>
