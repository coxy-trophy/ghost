<?xml version="1.0" encoding="utf-8"?>
<!-- The base glass surface: a barely-there fill so the aurora reads through, plus a hairline
     stroke to give the pane an edge. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/glass_fill" />
    <stroke android:width="1dp" android:color="@color/glass_stroke" />
    <corners android:radius="26dp" />
</shape>
