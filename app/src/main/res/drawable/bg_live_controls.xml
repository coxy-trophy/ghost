<?xml version="1.0" encoding="utf-8"?>
<!-- Live's secondary controls sit in the bottom corners as separate glass discs, not one bar. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/glass_fill_hover">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/glass_fill" />
            <stroke android:width="1dp" android:color="@color/glass_border" />
        </shape>
    </item>
</ripple>
