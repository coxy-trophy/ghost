<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/accent_cyan_dim">
    <item>
        <selector>
            <!-- Disabled controls dim rather than disappear: GHOST's state should stay legible. -->
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <solid android:color="#0AFFFFFF" />
                    <stroke android:width="1dp" android:color="@color/glass_stroke_soft" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/accent_cyan_ghost" />
                    <stroke android:width="1dp" android:color="@color/accent_cyan_dim" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/glass_fill" />
                    <stroke android:width="1dp" android:color="@color/glass_stroke" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
