<?xml version="1.0" encoding="utf-8"?>
<!-- Every configuration lives here. The chat and live screens carry none. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screen_system"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone"
    android:scrollbars="none"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ghost_system_title"
            android:textColor="@color/accent"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:text="@string/ghost_system_subtitle"
            style="@style/TextAppearance.Ghost.Mono" />

        <!-- ── Runtime ─────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ghost_sec_runtime"
                style="@style/TextAppearance.Ghost.Label"
                android:textColor="@color/accent" />

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginVertical="12dp" android:background="@color/divider" />

            <TextView
                android:id="@+id/gguf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:text="@string/ghost_status_idle"
                style="@style/TextAppearance.Ghost.Mono" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_start"
                    style="@style/Widget.Ghost.Primary"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:text="@string/ghost_start" />

                <Button
                    android:id="@+id/btn_stop"
                    style="@style/Widget.Ghost.Outline"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:enabled="false"
                    android:text="@string/ghost_stop" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <Button
                    android:id="@+id/btn_mic"
                    style="@style/Widget.Ghost.Outline"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:text="@string/ghost_mic_on" />

                <Button
                    android:id="@+id/btn_capture"
                    style="@style/Widget.Ghost.Outline"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:enabled="false"
                    android:text="@string/ghost_capture" />
            </LinearLayout>

            <!-- Her voice. Beside the mic on purpose: one button per channel, in and out. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <Button
                    android:id="@+id/btn_voice"
                    style="@style/Widget.Ghost.Outline"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/ghost_voice_on" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── Behaviour ───────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:layout_marginTop="14dp"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ghost_sec_behaviour"
                style="@style/TextAppearance.Ghost.Label"
                android:textColor="@color/accent" />

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginVertical="12dp" android:background="@color/divider" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:text="@string/ghost_sec_behaviour_desc"
                style="@style/TextAppearance.Ghost.Mono" />

            <Button
                android:id="@+id/btn_personality"
                style="@style/Widget.Ghost.Outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ghost_personality" />
        </LinearLayout>

        <!-- ── External compute ────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:layout_marginTop="14dp"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ghost_sec_cloud"
                style="@style/TextAppearance.Ghost.Label"
                android:textColor="@color/accent" />

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginVertical="12dp" android:background="@color/divider" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:text="@string/ghost_sec_cloud_desc"
                style="@style/TextAppearance.Ghost.Mono" />

            <Button
                android:id="@+id/btn_cloud"
                style="@style/Widget.Ghost.Outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ghost_cloud" />
        </LinearLayout>

        <!-- ── Local inference core ────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:layout_marginTop="14dp"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ghost_sec_core"
                style="@style/TextAppearance.Ghost.Label"
                android:textColor="@color/accent" />

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginVertical="12dp" android:background="@color/divider" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/ghost_active_weights"
                style="@style/TextAppearance.Ghost.Label" />

            <Button
                android:id="@+id/btn_pick"
                style="@style/Widget.Ghost.Outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ghost_pick_model" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
