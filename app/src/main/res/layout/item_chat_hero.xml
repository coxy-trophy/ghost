<?xml version="1.0" encoding="utf-8"?>
<!--
  The empty transcript: one line, asked once.

  The orb used to live here, three hundred and thirty density-independent pixels of it, and it has
  moved to Live where it belongs — a screen you open to talk to her, on a dark field it can read
  against. On a light page above a text composer it was a graphic occupying the space the first
  question should have.

  Still the transcript's first item rather than a separate empty state, so it scrolls away with the
  conversation instead of being swapped out under you.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chat_hero"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="start"
    android:paddingHorizontal="20dp"
    android:paddingTop="72dp"
    android:paddingBottom="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ghost_greeting_sub"
        style="@style/TextAppearance.Ghost.DisplaySub" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/ghost_greeting"
        style="@style/TextAppearance.Ghost.Display" />
</LinearLayout>
