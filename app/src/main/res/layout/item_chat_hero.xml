<?xml version="1.0" encoding="utf-8"?>
<!--
  The first thing in the transcript: the orb, then the question. Scrolls away with the conversation
  rather than being replaced by it, so it is somewhere you can always get back to.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chat_hero"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingHorizontal="32dp"
    android:paddingBottom="20dp">

    <!--
      Fixed height rather than a weight. Given the remaining space the orb took all of it and pushed
      the greeting to the floor, leaving the two reading as separate things; bounded, the orb and
      the words centre together as one block.
    -->
    <com.coxy.ghost.ui.OrbView
        android:id="@+id/orb"
        android:layout_width="match_parent"
        android:layout_height="330dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/ghost_greeting_sub"
        style="@style/TextAppearance.Ghost.DisplaySub" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="@string/ghost_greeting"
        style="@style/TextAppearance.Ghost.Display" />
</LinearLayout>
