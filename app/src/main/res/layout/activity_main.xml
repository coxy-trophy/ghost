<?xml version="1.0" encoding="utf-8"?>
<!--
  Five screens behind one drawer.

  All five are still inflated up front and swapped by visibility rather than by Fragments, exactly
  as before: MainActivity finds its views once in onCreate and the existing wiring keeps working.
  What changed is how you reach them. A five-icon bar across the bottom gave Chat a fifth of the
  furniture and said, permanently, that talking to GHOST is one of five equal things. It is not —
  it is the app, and the other four are places you go occasionally to check on her.

  The top bar is three objects and no containers: a hamburger, her name, and which brain is
  answering. The glass discs and the pill they used to sit in are gone. On a page this quiet a
  bordered disc around an icon is louder than the icon.
-->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/abyss"
    android:fitsSystemWindows="true">

    <!-- ── The screen ─────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/abyss">

        <FrameLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingHorizontal="8dp">

            <ImageButton
                android:id="@+id/btn_top_menu"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="start|center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_menu"
                android:scaleType="centerInside"
                android:padding="10dp"
                android:contentDescription="@string/ghost_nav_open"
                app:tint="@color/on_surface_variant" />

            <!--
              Her name and, under it, whether she is actually up.

              Kept from the old identity pill because the question it answers has not changed — a
              daemon that silently died looks exactly like one that is idle — but without the pill.
              The status dot carries the state and the words underneath say what she is sensing.
            -->
            <LinearLayout
                android:id="@+id/identity_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/ghost_nav_senses">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ghost_wordmark"
                    style="@style/TextAppearance.Ghost.Wordmark" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:id="@+id/status_dot"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:layout_marginEnd="5dp"
                        android:background="@drawable/bg_status_dot" />

                    <TextView
                        android:id="@+id/perception"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:text="@string/ghost_perception_idle"
                        style="@style/TextAppearance.Ghost.PillCaption" />
                </LinearLayout>
            </LinearLayout>

            <!-- Which brain is answering, as a control: tapping it opens the cloud settings. -->
            <ImageButton
                android:id="@+id/btn_top_brain"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="end|center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_spark"
                android:scaleType="centerInside"
                android:padding="11dp"
                android:contentDescription="@string/ghost_cloud"
                app:tint="@color/on_surface_variant" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <include layout="@layout/content_chat" />
            <include layout="@layout/content_live" />
            <include layout="@layout/content_system" />
            <include layout="@layout/content_perception" />
            <include layout="@layout/content_devices" />
        </FrameLayout>
    </LinearLayout>

    <!-- ── The drawer ─────────────────────────────────────────────────── -->
    <include
        layout="@layout/nav_drawer"
        android:layout_width="292dp"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

</androidx.drawerlayout.widget.DrawerLayout>
