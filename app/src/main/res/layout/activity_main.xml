<?xml version="1.0" encoding="utf-8"?>
<!--
  Three screens behind one bottom nav, per the Stitch design. All three are inflated up front and
  swapped by visibility rather than by Fragments: MainActivity finds its views once in onCreate and
  the existing wiring keeps working untouched, which is worth more here than lazy inflation of two
  small layouts.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/obsidian"
    android:fitsSystemWindows="true">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="18dp"
        android:paddingVertical="14dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_grid"
            android:contentDescription="@null"
            app:tint="@color/on_surface_muted" />

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/ghost_wordmark"
            style="@style/TextAppearance.Ghost.Wordmark" />

        <View
            android:id="@+id/status_dot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginEnd="7dp"
            android:background="@drawable/bg_status_dot" />

        <TextView
            android:id="@+id/perception"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="46dp"
            android:gravity="end"
            android:singleLine="true"
            android:text="@string/ghost_perception_idle"
            style="@style/TextAppearance.Ghost.Label" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- Screens -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include layout="@layout/content_chat" />
        <include layout="@layout/content_live" />
        <include layout="@layout/content_system" />
        <include layout="@layout/content_perception" />
    </FrameLayout>

    <!-- Bottom nav -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:background="@color/obsidian">

        <LinearLayout
            android:id="@+id/nav_chat"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:background="@drawable/bg_nav_active"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/nav_chat_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_chat"
                android:contentDescription="@null"
                app:tint="@color/cyan" />

            <TextView
                android:id="@+id/nav_chat_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/ghost_nav_chat"
                style="@style/TextAppearance.Ghost.Label"
                android:textColor="@color/cyan" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_live"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/nav_live_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_live"
                android:contentDescription="@null"
                app:tint="@color/on_surface_muted" />

            <TextView
                android:id="@+id/nav_live_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/ghost_nav_live"
                style="@style/TextAppearance.Ghost.Label" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_system"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/nav_system_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_system"
                android:contentDescription="@null"
                app:tint="@color/on_surface_muted" />

            <TextView
                android:id="@+id/nav_system_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/ghost_nav_system"
                style="@style/TextAppearance.Ghost.Label" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_senses"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/nav_senses_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_senses"
                android:contentDescription="@null"
                app:tint="@color/on_surface_muted" />

            <TextView
                android:id="@+id/nav_senses_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/ghost_nav_senses"
                style="@style/TextAppearance.Ghost.Label" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
