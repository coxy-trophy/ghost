<?xml version="1.0" encoding="utf-8"?>
<!--
  Devices. Everything GHOST has ever seen on any network she has been on, newest network first,
  with the one you are on now at the top and marked.

  Built at runtime rather than as a RecyclerView: the list is a handful of networks and a few dozen
  devices, it is rebuilt whole after every scan or rename, and an adapter for that is more moving
  parts than the screen is worth.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/screen_devices"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ghost_devices_title"
                style="@style/TextAppearance.Ghost.Display"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/devices_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/ghost_devices_subtitle"
                android:textSize="12sp"
                android:textColor="@color/on_surface_muted" />
        </LinearLayout>

        <!-- Manual scan. Deliberately a button rather than something that happens on arriving:
             a sweep wakes every device on the network and should be something Coxy asks for. -->
        <Button
            android:id="@+id/devices_scan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:minWidth="0dp"
            android:text="@string/ghost_devices_scan"
            style="@style/Widget.Ghost.Outline" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/devices_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp" />
    </ScrollView>
</LinearLayout>
