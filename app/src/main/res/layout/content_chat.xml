<?xml version="1.0" encoding="utf-8"?>
<!--
  Chat. The orb and one question sit at the top of the transcript as its first item, so the
  conversation scrolls past them rather than replacing them; the telemetry row and composer stay
  put. The sensor pills sit directly above the composer rather than in a bordered card at the top,
  because they are context for what you are about to say.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/screen_chat"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/messages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="0dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:overScrollMode="never"
        tools:listitem="@layout/item_message_assistant" />

    <!--
      Sensor telemetry. Built at runtime from ContextState so the row shows only what is actually
      known, the same rule the [CONTEXT] prompt block follows. It bleeds off both edges instead of
      sitting in a card: the readings are a strip you can push around, not a panel.
    -->
    <HorizontalScrollView
        android:id="@+id/sensor_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:paddingHorizontal="16dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/sensor_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_bar"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="6dp"
            android:minHeight="54dp">

            <EditText
                android:id="@+id/user_input"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:background="@null"
                android:enabled="false"
                android:maxLines="4"
                android:paddingVertical="15dp"
                android:textSize="15sp"
                android:textColor="@color/on_surface"
                android:textColorHint="@color/on_surface_muted"
                android:textCursorDrawable="@null"
                android:inputType="textCapSentences|textMultiLine"
                android:hint="@string/ghost_input_hint" />

            <!-- Grab a frame for GHOST to reason about. Same action as System's Capture. -->
            <ImageButton
                android:id="@+id/btn_capture_chat"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:enabled="false"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_camera"
                android:scaleType="centerInside"
                android:padding="10dp"
                android:contentDescription="@string/ghost_capture"
                app:tint="@color/on_surface_muted" />
        </LinearLayout>

        <!-- The one saturated object on the screen. -->
        <ImageButton
            android:id="@+id/fab"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginStart="10dp"
            android:enabled="false"
            android:background="@drawable/bg_send"
            android:scaleType="centerInside"
            android:padding="15dp"
            android:contentDescription="@string/ghost_send"
            android:src="@drawable/outline_send_24"
            app:tint="@color/white" />
    </LinearLayout>
</LinearLayout>
