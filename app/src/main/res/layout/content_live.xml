<?xml version="1.0" encoding="utf-8"?>
<!--
  Live mode: talking to her.

  In Chat the orb is an object across the room that the transcript scrolls past. Here it is the
  screen — you are not reading a conversation, you are in one, and the only things that matter are
  whether she is listening, what she heard, and what she said back.

  Three things used to compete to be her presence here: a bloom rising off the bottom edge, a
  waveform ribbon across the top, and a ring of buttons. None of them won, and the screen read as
  busy in a mode that should feel like standing still. The bloom and the ribbon are gone; the orb
  carries both jobs now — it is the light source, and it swells with your voice, so the meter is
  the presence rather than a second thing beside it.

  Everything is one vertical stack. The old layout positioned four blocks by hardcoded margins from
  opposite edges (206dp from the top, 216dp then 104dp from the bottom), which meant nothing had a
  relationship to anything else and any change to one moved the others by hand.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/screen_live"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!--
          Fixed, not weighted. Given the remaining space the orb takes all of it and drives the
          text to the floor — the same fault that put the Chat greeting on the bottom edge.
        -->
        <com.coxy.ghost.ui.OrbView
            android:id="@+id/live_orb"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="4dp" />

        <!-- Her state, tight under her, like a nameplate rather than a status bar. -->
        <TextView
            android:id="@+id/live_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ghost_live_idle"
            style="@style/TextAppearance.Ghost.Label"
            android:textColor="@color/accent_soft"
            android:textSize="11sp" />

        <!--
          What she heard. The largest thing on the screen, because it is the one you check
          mid-sentence to know whether you were understood.
        -->
        <TextView
            android:id="@+id/live_heard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:paddingHorizontal="34dp"
            android:gravity="center"
            android:maxLines="3"
            android:ellipsize="end"
            android:textColor="@color/on_surface"
            android:textSize="22sp"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingExtra="2dp"
            android:letterSpacing="-0.02" />

        <!--
          What she said. Deliberately quieter than what she heard: in Live you are listening to
          this, not reading it, and it only needs to confirm that she answered.
        -->
        <TextView
            android:id="@+id/live_reply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:paddingHorizontal="34dp"
            android:gravity="center"
            android:maxLines="4"
            android:ellipsize="end"
            android:textColor="@color/on_surface_variant"
            android:textSize="15sp"
            android:lineSpacingExtra="3dp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!--
          One row, not three positions. Talk is the only saturated thing on the screen and sits in
          the middle where a thumb lands; the two that end the moment are pushed to the edges, far
          enough that neither is in the path of reaching for it.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="26dp">

            <ImageButton
                android:id="@+id/live_mute"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_live_controls"
                android:contentDescription="@string/ghost_live_latch"
                android:src="@drawable/ic_mic_off"
                android:scaleType="centerInside"
                android:padding="15dp"
                app:tint="@color/on_surface_variant" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <FrameLayout
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:background="@drawable/bg_ptt_rings">

                <ImageButton
                    android:id="@+id/live_ptt"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_ptt"
                    android:contentDescription="@string/ghost_ptt_hold"
                    android:src="@drawable/ic_mic"
                    android:scaleType="centerInside"
                    android:padding="23dp"
                    app:tint="@color/white" />
            </FrameLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/live_exit"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_live_controls"
                android:contentDescription="@string/ghost_live_exit"
                android:src="@drawable/ic_close"
                android:scaleType="centerInside"
                android:padding="15dp"
                app:tint="@color/on_surface_variant" />
        </LinearLayout>

        <TextView
            android:id="@+id/live_ptt_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:text="@string/ghost_ptt_hold"
            style="@style/TextAppearance.Ghost.Label"
            android:textColor="@color/on_surface_muted"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
