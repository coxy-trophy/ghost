<?xml version="1.0" encoding="utf-8"?>
<!--
  Live mode. The orb belongs to Chat; here GHOST is not an object across the room but a light you
  are standing in, so the screen is a bloom rising off the bottom edge with the hold-to-speak
  button at its hottest point.

  The band across the top is the mic itself — see WaveformView. Between them sits what she actually
  heard, which is the one thing worth reading at arm's length while you are talking.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/screen_live"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <View
        android:layout_width="match_parent"
        android:layout_height="440dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_floor_bloom" />

    <com.coxy.ghost.ui.WaveformView
        android:id="@+id/waveform"
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:layout_gravity="top"
        android:layout_marginTop="18dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="206dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="32dp">

        <TextView
            android:id="@+id/live_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ghost_live_idle"
            style="@style/TextAppearance.Ghost.Label"
            android:textColor="@color/accent_soft"
            android:textSize="12sp" />

        <!-- What GHOST heard. The largest text in Live, because it is the one thing you check
             mid-sentence to know whether you were understood. -->
        <TextView
            android:id="@+id/live_heard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:maxLines="3"
            android:ellipsize="end"
            android:textColor="@color/on_surface"
            android:textSize="21sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.02" />
    </LinearLayout>

    <TextView
        android:id="@+id/live_reply"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="216dp"
        android:paddingHorizontal="30dp"
        android:gravity="center"
        android:maxLines="4"
        android:ellipsize="end"
        style="@style/TextAppearance.Ghost.Body"
        android:textColor="@color/on_surface" />

    <!--
      Push to talk. Largest target on the screen and the only saturated one, because with nothing
      listening ambiently this is the whole way in.
    -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="104dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <FrameLayout
            android:layout_width="128dp"
            android:layout_height="128dp"
            android:background="@drawable/bg_ptt_rings">

            <ImageButton
                android:id="@+id/live_ptt"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_ptt"
                android:contentDescription="@string/ghost_ptt_hold"
                android:src="@drawable/ic_mic"
                android:scaleType="centerInside"
                android:padding="24dp"
                app:tint="@color/white" />
        </FrameLayout>

        <TextView
            android:id="@+id/live_ptt_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ghost_ptt_hold"
            style="@style/TextAppearance.Ghost.Label"
            android:textColor="@color/on_surface_variant"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Secondary controls, pushed to the corners so neither can be hit while reaching for talk. -->
    <ImageButton
        android:id="@+id/live_mute"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="28dp"
        android:layout_marginBottom="26dp"
        android:background="@drawable/bg_live_controls"
        android:contentDescription="@string/ghost_live_latch"
        android:src="@drawable/ic_mic_off"
        android:scaleType="centerInside"
        android:padding="15dp"
        app:tint="@color/on_surface" />

    <ImageButton
        android:id="@+id/live_exit"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="26dp"
        android:background="@drawable/bg_live_controls"
        android:contentDescription="@string/ghost_live_exit"
        android:src="@drawable/ic_close"
        android:scaleType="centerInside"
        android:padding="15dp"
        app:tint="@color/on_surface" />
</FrameLayout>
