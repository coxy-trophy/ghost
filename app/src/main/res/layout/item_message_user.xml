<?xml version="1.0" encoding="utf-8"?>
<!--
  What Coxy said. The only bubble left in the transcript.

  Right-aligned and capped short of the full width so the eye can find where each turn starts
  without a label. Her replies are unbubbled and full-width, which makes the two speakers tell
  apart by shape alone.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginHorizontal="20dp"
    android:layout_marginTop="18dp"
    android:layout_marginBottom="10dp"
    android:gravity="end">

    <TextView
        android:id="@+id/msg_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="280dp"
        android:background="@drawable/bg_user_message"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        style="@style/TextAppearance.Ghost.Body"
        android:textIsSelectable="true" />
</LinearLayout>
