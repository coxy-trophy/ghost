<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Phase 7 action layer: adjust screen brightness via Settings.System. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!-- Phase 8 cloud brain: reach the Ollama Cloud API. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Phase 4.5 perception. BLUETOOTH_SCAN carries neverForLocation: GHOST counts nearby BLE
         devices and names only ones already paired to this phone, and never derives position from
         them. READ_PHONE_STATE is for call state and signal only — no numbers, contacts or
         messages. NFC is declared for completeness; a background service cannot read tags. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.NFC" />

    <!-- Phase 5 kill switch: custom permission gating the exported KillReceiver. Runtime
         (dangerous) so it can be granted to com.android.shell via `pm grant` (normal-protection
         perms are install-time-only and reject pm grant). Granted once so adb can fire KILL. -->
    <permission
        android:name="com.coxy.ghost.permission.KILL"
        android:protectionLevel="dangerous" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:extractNativeLibs="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AiChatSample"
        >

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".GhostService"
            android:exported="false"
            android:foregroundServiceType="specialUse|location|camera|microphone">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="ambient_always_on_local_inference" />
        </service>

        <!-- Phase 5 kill switch (D3): Quick Settings tile — the always-available, UI-external channel. -->
        <service
            android:name=".KillSwitchTile"
            android:exported="true"
            android:icon="@drawable/outline_send_24"
            android:label="@string/ghost_kill_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Phase 5 kill switch (D3): shell-reachable broadcast backstop. Exported without a
             permission gate — custom app-defined permissions aren't shell-changeable on this device
             (pm grant returns "not a changeable permission type"), so a gate would block the one
             channel we can drive from adb. KILL is a safe, reversible action (it only stops GHOST),
             so the open-export risk is accepted. The QS tile + volume-key remain the gated channels. -->
        <receiver
            android:name=".KillReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.coxy.ghost.action.KILL" />
            </intent-filter>
        </receiver>

        <!-- Phase 5 kill switch (D3): volume-key combo hardware channel. Requires the user to
             manually enable the service in Settings → Accessibility (one-time). -->
        <service
            android:name=".GhostAccessibilityService"
            android:exported="false"
            android:label="@string/ghost_kill_tile"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/ghost_accessibility" />
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Phase 7: confirm/decline buttons on Tier-3 action notifications. -->
        <receiver
            android:name=".action.ActionConfirmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.coxy.ghost.action.CONFIRM_ACTION" />
                <action android:name="com.coxy.ghost.action.DECLINE_ACTION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>