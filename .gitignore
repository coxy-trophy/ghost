# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Log/OS Files
*.log

# Android Studio generated files and folders
captures/
.externalNativeBuild/
.cxx/
*.apk
output.json

# IntelliJ
*.iml
.idea/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# Keystore files
*.jks
*.keystore

# Baked-in secrets. keys.properties holds OLLAMA_API_KEY and is read by app/build.gradle.kts into
# a BuildConfig field, so the cloud brain survives a priv-app deploy wiping /data/data without
# anyone re-entering it by hand. Never commit this. keys.properties.example is the template.
keys.properties

# Google Services (e.g. APIs or Firebase)
google-services.json

# Android Profiling
*.hprof

# Kotlin incremental-compile cache
.kotlin/

# macOS
.DS_Store

# KWS training data cache (550 MB): the downloaded mini_speech_commands dataset and the
# `say`-synthesised positives. Both are regenerated by tools/train_hey_ghost_kws.py.
# Real recorded "Hey Ghost" samples are NOT regenerable — force-add those if they land here.
tools/kws_data/

# Fetched by tools/install_piper_voice.sh from k2-fsa's own release. 49 MB of native
# binaries does not belong in git history.
app/libs/*.aar

# Local Python verification tools
__pycache__/
*.pyc

# Generated compile-only AOSP definitions, verified by tools/install_system_api_stubs.py
app/libs/android-system-api-34-stubs.jar
