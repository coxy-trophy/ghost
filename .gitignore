# Baked-in secrets. keys.properties holds OLLAMA_API_KEY and is read by app/build.gradle.kts into
# a BuildConfig field, so the cloud brain survives a priv-app deploy wiping /data/data without
# anyone re-entering it by hand. Never commit this. keys.properties.example is the template.
keys.properties

# Google Services (e.g. APIs or Firebase)
google-services.json

# Android Profiling
*.hprof

# Kotlin incremental-compile cache
.kotlin/

# macOS
.DS_Store

# KWS training data cache (550 MB): the downloaded mini_speech_commands dataset and the
# `say`-synthesised positives. Both are regenerated by tools/train_hey_ghost_kws.py.
# Real recorded "Hey Ghost" samples are NOT regenerable — force-add those if they land here.
tools/kws_data/
